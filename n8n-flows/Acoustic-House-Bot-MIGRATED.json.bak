    {
      "parameters": {
        "jsCode": "// Generate time slots for next 7 weekdays\nconst now = new Date();\nconst slots = [];\nlet daysAdded = 0;\nlet currentDay = new Date(now);\n\nwhile (daysAdded < 7) {\n  currentDay.setDate(currentDay.getDate() + 1);\n  const dayOfWeek = currentDay.getDay();\n  \n  // Skip weekends\n  if (dayOfWeek === 0 || dayOfWeek === 6) continue;\n  \n  const dateStr = currentDay.toISOString().split('T')[0];\n  \n  // Add time slots for this day\n  const times = ['09:00', '10:00', '11:00', '14:00', '15:00', '16:00'];\n  times.forEach(time => {\n    const [hour, minute] = time.split(':');\n    const slotTime = new Date(currentDay);\n    slotTime.setHours(parseInt(hour), parseInt(minute), 0, 0);\n    \n    slots.push({\n      identifier: `${dateStr}_${time.replace(':', '')}`,\n      startTime: slotTime.toISOString(),\n      duration: 60  // 1 hour slots\n    });\n  });\n  \n  daysAdded++;\n}\n\nreturn {\n  json: {\n    ...($json || {}),\n    timeSlots: slots\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, -200],
      "id": "generate-slots",
      "name": "Generate Time Slots"
    },
    {
      "parameters": {
        "accountId": "={{ $('Router with State').item.json.accountId }}",
