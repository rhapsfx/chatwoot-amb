        "url": "=https://app.chatwoot.com/api/v1/accounts/{{ $('Router with State').item.json.accountId }}/conversations/{{ $('Router with State').item.json.conversationId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "✅ Your appointment is confirmed! We'll send you a reminder before your visit.\n\n📍 Acoustic House Showroom\n123 Music Street\nSan Francisco, CA 94102\n\nSee you soon! 🎸"
            },
            {
